# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WebRTC Signaling & ICE Configuration (Client-side optional overrides)
VITE_SIGNALING_WS_URL=""
VITE_STUN_URL="stun:stun.l.google.com:19302"
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""

# Optional Server-Side PSTN Telephony Provider (Twilio)
# Keep secrets strictly on the server; never expose with VITE_ prefix.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

